{
  "name": "classfinder",
  "version": "0.1.0",
  "private": true,
  "description": "Infrastructure foundation for the ClassFinder web application.",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --passWithNoTests --coverage.enabled",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:smoke": "node scripts/smoke-infrastructure.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.1",
    "globals": "16.0.0",
    "jsdom": "29.1.1",
    "playwright": "1.63.0",
    "prettier": "3.5.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vite": "6.4.3",
    "vitest": "^5.0.1"
  }
}
